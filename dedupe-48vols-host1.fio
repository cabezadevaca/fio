[global]
direct=1
iodepth=4
ioengine=libaio
rw=write
bs=256k
thread=1
randrepeat=0
refill_buffers=1
dedupe_mode=working_set2
dedupe_working_set_percentage=5
dedupe_percentage=50
dedupe_bs=4096
dedupe_use_unique_bitmap=1
dedupe_buf_randrepeat=1
dedupe_global=1
group_reporting=1
per_job_logs=0
size=10m
buffer_compress_percentage=50
dedupe_loadgen_num=1
dedupe_loadgen_count=2
